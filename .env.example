# Plantilla con valores FICTICIOS. Copia a .env (ignorado por git) y ajusta en local.
# Databricks: autentica con `databricks auth login --profile emerson`; aquí solo va el nombre del perfil.
ADVISOR_DATABRICKS_PROFILE=emerson
ADVISOR_DATABRICKS_WAREHOUSE_ID=0000000000000000
ADVISOR_REPOSITORY_BACKEND=local          # local | databricks_sql
ADVISOR_RETRIEVAL_BACKEND=bm25            # bm25 | faiss | hybrid | ai_search
ADVISOR_LLM_PROVIDERS=template            # orden de fallback: databricks,ollama,template
ADVISOR_OLLAMA_HOST=http://localhost:11434
# Claude (opción "Claude (API key)" del chat; requiere `uv sync --extra claude`). Key real solo en .env.
ANTHROPIC_API_KEY=
# ADVISOR_CLAUDE_MODEL=claude-haiku-5-5   # o claude-sonnet-5-5
# ADVISOR_LLM_DEFAULT=claude              # preselecciona Claude en el chat
