# Plantilla de configuración. Valores FICTICIOS: copia a .env y ajusta localmente. Nunca subas .env.
EMERSON_ENV=local
EMERSON_LOG_LEVEL=INFO
EMERSON_LOG_JSON=true
EMERSON_DATA_DIR=data
EMERSON_SYNTHETIC_DATA_ONLY=true
EMERSON_RETRIEVAL_BACKEND=bm25
EMERSON_RETRIEVAL_TOP_K=5
EMERSON_LLM_PROVIDER=none
EMERSON_LLM_ENDPOINT=https://example-workspace.cloud.databricks.com/serving-endpoints/example-llm
# Autenticación con `databricks auth login`; aquí solo el nombre del perfil.
DATABRICKS_CONFIG_PROFILE=example-profile
EMERSON_UC_CATALOG=emerson_hw
EMERSON_UC_SCHEMA_BRONZE=bronze
EMERSON_UC_SCHEMA_SILVER=silver
EMERSON_UC_SCHEMA_GOLD=gold
